# Configure these values as Stack environment variables in Portainer.
# Do not commit a real .env.docker file or secrets.
# DATABASE_URL must be the Railway PostgreSQL URL, not localhost.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway?schema=public
# Optional. Leave empty to disable queue processing locally.
REDIS_URL=
# Image is built and published by GitHub Actions, not on the Portainer host.
BACKEND_IMAGE=ghcr.io/paulgarcia89/saas-integral-backend
IMAGE_TAG=latest
BACKEND_PORT=3000
NODE_ENV=production
