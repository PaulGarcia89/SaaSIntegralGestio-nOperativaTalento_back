# Plantilla de variables para el despliegue LAN.
# Copiar a deploy/.env.lan (ignorado por git) y rellenar con valores propios.
#
#   mkdir -p deploy && cp .env.lan.example deploy/.env.lan
#   docker compose --env-file deploy/.env.lan -f docker-compose.lan.yml up -d --build
#
# Generar cada secreto con:  openssl rand -hex 32

POSTGRES_PASSWORD=replace-with-postgres-password
JWT_ACCESS_SECRET=replace-with-access-secret-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-refresh-secret-openssl-rand-hex-32
SCORM_SIGNING_KEY=replace-with-scorm-signing-key-openssl-rand-hex-32
WEBHOOK_ENCRYPTION_KEY=replace-with-webhook-encryption-key-openssl-rand-hex-32
SUPERADMIN_PASSWORD=ChangeMe123!
