{
  "name": "saas-integral-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"console.log('Prisma se genera durante el build')\"",
    "start": "npm run start:fluentops",
    "start:fluentops": "prisma migrate deploy && prisma generate && node compiled-server/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "build": "prisma generate && nest build",
    "test:applications:tracking": "node scripts/test-applications-tracking.mjs",
    "test:automation:rules": "ts-node -r dotenv/config scripts/test-automation-rules.ts",
    "test:automation:flow": "ts-node -r dotenv/config scripts/test-automation-flow.ts",
    "test:domain-events:idempotency": "ts-node -r dotenv/config scripts/test-domain-event-idempotency.ts",
    "test:domain-events:retry": "ts-node -r dotenv/config scripts/test-domain-event-retry.ts",
    "test:platform:capabilities": "node -r ts-node/register scripts/test-platform-capabilities.ts",
    "test:authorization:boundaries": "ts-node scripts/test-authorization-boundaries.ts",
    "test:rbac": "ts-node test/rbac/rbac-security.test.ts",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:e2e:prepare": "prisma migrate deploy && ts-node -r dotenv/config prisma/seed.ts",
    "test:e2e:full": "npm run test:e2e:prepare && npm run test:e2e",
    "test:cov": "jest --coverage --runInBand",
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "certify": "npm run build && npm test && npm run audit:production",
    "certify:integrations:production": "ts-node -r dotenv/config scripts/certify-production-integrations.ts",
    "certify:ats:production": "node --env-file-if-exists=.env scripts/certify-ats-production.mjs",
    "load:ats:railway": "k6 run k6/ats-railway-readonly.js",
    "backup": "bash scripts/backup-production.sh",
    "restore:verify": "bash scripts/verify-backup.sh",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test:training": "node scripts/test-training-module.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node -r dotenv/config prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/lib-storage": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/common": "^10.4.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.2",
    "@prisma/client": "^6.19.3",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "adm-zip": "^0.6.0",
    "amqplib": "^0.10.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.6"
  }
}
