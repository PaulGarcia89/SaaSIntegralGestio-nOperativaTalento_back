  evidences            InventoryEvidence[]

  @@unique([tenantId, assetTag])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, itemId])
}

