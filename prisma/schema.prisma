  communications         AtsMessage[]
  scorecardTemplates     ScorecardTemplate[]
  decisionCommittees     HiringDecisionCommittee[]
  jobBoardPostings       JobBoardPosting[]
  employeeReferrals      EmployeeReferral[]
  publicApplicationDrafts PublicApplicationDraft[]
  candidateConversionEvents CandidateConversionEvent[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, requisitionId])
  @@index([clonedFromVacancyId])
}

model VacancyLocation {
  id        String   @id @default(uuid())
