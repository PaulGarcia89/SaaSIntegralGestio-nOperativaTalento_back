  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model InventoryPurchaseOrder {
  id            String                       @id @default(uuid())
  tenantId      String
  branchId      String
  supplierId    String
  code          String
  status        String                       @default("DRAFT")
  currency      String                       @default("USD")
