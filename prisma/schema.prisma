  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model TrainingCertificate {
  id                String                       @id @default(uuid())
  tenantId          String
  userId            String
  curriculumId      String?
  courseId          String?
  certificateUrl    String
  verificationCode  String                       @unique
  certificateNumber String                       @unique
  policyId          String?
  policyVersion     Int?
  evidenceSnapshot  Json?
  issuedById        String?
  issuedReason      String                       @default("COMPLETION")
  renewedFromId     String?
  supersededAt      DateTime?
  issuedAt          DateTime
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedById       String?
  revocationReason  String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculum        TrainingCurriculum?          @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  course            TrainingCourse?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
