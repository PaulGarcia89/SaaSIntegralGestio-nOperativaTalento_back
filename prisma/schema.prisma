  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, branchId])
  @@index([tenantId, branchId, releasedAt])
  @@index([tenantId, employeeId, releasedAt])
}

model InventoryItem {
  id                   String                @id @default(uuid())
  tenantId             String
  sku                  String
  name                 String
  qtyGlobal            Int                   @default(0)
  isSerialized         Boolean               @default(true)
  unitOfMeasure        String                @default("unidad")
