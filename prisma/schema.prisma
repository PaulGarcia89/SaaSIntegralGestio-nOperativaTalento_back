  dkimVerified    Boolean                   @default(false)
  dmarcVerified   Boolean                   @default(false)
  reputationScore Decimal?                  @db.Decimal(5, 2)
  deliveryRate    Decimal?                  @db.Decimal(5, 2)
  bounceRate      Decimal?                  @db.Decimal(5, 2)
  complaintRate   Decimal?                  @db.Decimal(5, 2)
  lastCheckedAt   DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, lastCheckedAt])
}

model CandidateChannelPreference {
