model TrainingAssignment {
  id              String                       @id @default(uuid())
  tenantId        String
  userId          String
  curriculumId    String?
  courseId        String?
  assignedById    String?
  launchId        String?
  assignmentType  TrainingAssignmentType
  sourceType      TrainingAssignmentSourceType
  isRequired      Boolean                      @default(true)
  dueAt           DateTime?
  startAt         DateTime?
  completedAt     DateTime?
  progressPercent Int                          @default(0)
  status          TrainingProgressStatus       @default(NOT_STARTED)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                         @relation("TrainingAssignmentsUser", fields: [userId], references: [id], onDelete: Cascade)
  curriculum      TrainingCurriculum?          @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course          TrainingCourse?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignedBy      User?                        @relation("TrainingAssignmentsAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  launch          TrainingLaunch?              @relation(fields: [launchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, curriculumId])
  @@unique([tenantId, userId, courseId])
  @@index([tenantId, userId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, startAt])
  @@index([launchId])
}

model TrainingLaunch {
  id                   String                 @id @default(uuid())
  tenantId             String
  courseId             String
  createdById          String?
  name                 String
  status               TrainingLaunchStatus   @default(DRAFT)
  audience             TrainingLaunchAudience
  targetIds            String[]
  resolvedUserIds      String[]
  nextAudienceIndex    Int                    @default(0)
  batchSize            Int                    @default(100)
  rolloutIntervalHours Int                    @default(0)
  isRequired           Boolean                @default(true)
  startAt              DateTime?
  dueAt                DateTime?
  nextBatchAt          DateTime?
  processingAt         DateTime?
  launchedAt           DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course               TrainingCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy            User?                  @relation("TrainingLaunchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments          TrainingAssignment[]

  @@index([tenantId, status, createdAt])
  @@index([status, nextBatchAt])
  @@index([courseId])
}

model TrainingCourseImprovement {
  id           String                      @id @default(uuid())
  tenantId     String
  courseId     String
  ownerId      String?
  createdById  String?
  title        String
  description  String?
  status       TrainingImprovementStatus   @default(OPEN)
  priority     TrainingImprovementPriority @default(MEDIUM)
  source       TrainingImprovementSource   @default(MANUAL)
