  id              String                   @id @default(uuid())
  tenantId        String
  vacancyId       String?
  stageCode       String?
  type            AtsCommunicationType
  audience        AtsCommunicationAudience
  name            String
  subject         String
  body            String
  version         Int                      @default(1)
  isActive        Boolean                  @default(true)
  createdByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  vacancy         Vacancy?                 @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  messages        AtsMessage[]

  @@unique([tenantId, vacancyId, stageCode, type, audience, version])
  @@index([tenantId, type, audience, isActive])
  @@index([tenantId, vacancyId, stageCode])
}

model AtsMessage {
  id                      String                    @id @default(uuid())
  tenantId                String
  vacancyId               String
  applicationId           String
  interviewId             String?
  notificationId          String?                   @unique
  templateId              String?
  templateVersion         Int?
  type                    AtsCommunicationType
  audience                AtsCommunicationAudience
  direction               AtsMessageDirection       @default(OUTBOUND)
  channel                 NotificationChannel       @default(EMAIL)
  recipientEmail          String
  senderEmail             String?
  recipientName           String?
  recipientUserId         String?
  subject                 String
  body                    String
  status                  AtsMessageStatus          @default(PENDING)
  scheduledAt             DateTime                  @default(now())
  nextAttemptAt           DateTime                  @default(now())
  attempts                Int                       @default(0)
  maxAttempts             Int                       @default(5)
  lastAttemptAt           DateTime?
  deliveredAt             DateTime?
  providerMessageId       String?
  inReplyToMessageId      String?
  conversationId          String?
  internetMessageId       String?
  referencesHeader        String?
  readAt                  DateTime?
  lastError               String?
  correlationId           String?
  deduplicationKey        String
  createdByType           String                    @default("SYSTEM")
  createdById             String?
  payload                 Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  vacancy                 Vacancy                   @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  application             VacancyApplication        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interview               ApplicationInterview?     @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  template                AtsCommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  notification            Notification?             @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  conversation            AtsConversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  attachments             AtsMessageAttachment[]
  talentCampaignRecipient TalentCampaignRecipient?

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, applicationId, createdAt])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, recipientEmail, createdAt])
  @@index([tenantId, direction, channel, createdAt])
  @@index([tenantId, providerMessageId])
  @@index([interviewId, type])
}

model AtsConversation {
  id             String                @id @default(uuid())
  tenantId       String
  applicationId  String                @unique
  status         AtsConversationStatus @default(OPEN)
  assignedUserId String?
  unreadCount    Int                   @default(0)
  lastMessageAt  DateTime              @default(now())
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  snoozedUntil   DateTime?
  archivedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application    VacancyApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages       AtsMessage[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assignedUserId, lastMessageAt])
  @@index([tenantId, unreadCount, lastMessageAt])
}

model AtsMessageAttachment {
  id                   String     @id @default(uuid())
  tenantId             String
  messageId            String
  providerAttachmentId String
  filename             String
  mimeType             String
  sizeBytes            Int?
  disposition          String?
  contentId            String?
  createdAt            DateTime   @default(now())
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message              AtsMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, providerAttachmentId])
  @@index([tenantId, messageId])
}

model AtsUnmatchedInboundEmail {
  id                  String                @id @default(uuid())
  tenantId            String
  providerMessageId   String
  providerEventId     String
  senderEmail         String
  recipientEmail      String
  subject             String
  body                String
  status              AtsInboundMatchStatus @default(UNMATCHED)
  linkedApplicationId String?
  resolvedByUserId    String?
  resolvedAt          DateTime?
  reason              String?
  attachments         Json?
  occurredAt          DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, status, occurredAt])
}

model CommunicationDomain {
  id              String                    @id @default(uuid())
  tenantId        String                    @unique
  domain          String
  fromName        String
  fromEmail       String
  replyToEmail    String?
  dkimSelector    String                    @default("resend")
