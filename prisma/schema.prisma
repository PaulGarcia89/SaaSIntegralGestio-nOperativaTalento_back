  @@unique([tenantId, userId, curriculumId])
  @@unique([tenantId, userId, courseId])
  @@index([tenantId, userId, status])
  @@index([tenantId, lastActivityAt])
}

model TrainingStepProgress {
  id               String             @id @default(uuid())
  tenantId         String
  userId           String
  courseStepId     String
  isCompleted      Boolean            @default(false)
  completedAt      DateTime?
  score            Int?
  timeSpentSeconds Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseStep       TrainingCourseStep @relation(fields: [courseStepId], references: [id], onDelete: Cascade)

  @@unique([userId, courseStepId])
  @@index([tenantId, userId])
}

model TrainingEvent {
  id                  String                    @id @default(uuid())
  tenantId            String
  title               String
  description         String?
  startsAt            DateTime
  endsAt              DateTime?
  location            String?
  modality            TrainingEventModality
  relatedCourseId     String?
  relatedCurriculumId String?
  capacity            Int?
  meetingUrl          String?
  timeZone            String                    @default("UTC")
  provider            String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relatedCourse       TrainingCourse?           @relation(fields: [relatedCourseId], references: [id], onDelete: SetNull)
  relatedCurriculum   TrainingCurriculum?       @relation(fields: [relatedCurriculumId], references: [id], onDelete: SetNull)
  attendances         TrainingEventAttendance[]

  @@index([tenantId, startsAt])
  @@index([relatedCourseId])
  @@index([relatedCurriculumId])
}

model TrainingScormPackage {
  id          String                 @id @default(uuid())
  tenantId    String
  courseId    String
  title       String
  version     String
  launchUrl   String
  manifest    Json
  checksum    String
  storagePath String?
  fileSize    Int?
  status      String                 @default("READY")
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      TrainingCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions    TrainingScormSession[]

  @@index([tenantId, courseId])
}

model TrainingScormSession {
  id              String               @id @default(uuid())
  tenantId        String
  packageId       String
  userId          String
  status          String               @default("IN_PROGRESS")
  score           Int?
  progressPercent Int                  @default(0)
  suspendData     Json?
  startedAt       DateTime             @default(now())
  lastActivityAt  DateTime             @default(now())
  completedAt     DateTime?
  package         TrainingScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
}

model TrainingXapiStatement {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  statementId String   @unique
  verb        String
  objectId    String
  result      Json?
  context     Json?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId, userId, occurredAt])
}

model TrainingWebhook {
  id              String                    @id @default(uuid())
  tenantId        String
  name            String
  endpointUrl     String
  eventTypes      String[]
  secretHash      String
  secretEncrypted String?
  isActive        Boolean                   @default(true)
  lastStatus      String?
  lastError       String?
  lastDeliveryAt  DateTime?
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deliveries      TrainingWebhookDelivery[]

  @@index([tenantId, isActive])
}

model TrainingWebhookDelivery {
  id             String          @id @default(uuid())
  tenantId       String
  webhookId      String
  eventType      String
  eventId        String
  payload        Json
  status         String          @default("PENDING")
  attemptCount   Int             @default(0)
  responseStatus Int?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  webhook        TrainingWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([tenantId, status, nextAttemptAt])
}

model TrainingRecommendation {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  courseId    String
  reason      String
  evidence    Json
  status      String    @default("SUGGESTED")
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, userId, status])
}

model TrainingEventAttendance {
  id           String                        @id @default(uuid())
  eventId      String
  userId       String
  status       TrainingEventAttendanceStatus @default(INVITED)
  registeredAt DateTime?
  attendedAt   DateTime?
  notes        String?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  event        TrainingEvent                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model TrainingLibraryResource {
  id              String               @id @default(uuid())
  tenantId        String?
  categoryId      String?
  title           String
  slug            String
  description     String?
  resourceType    TrainingResourceType
  fileUrl         String?
  thumbnailUrl    String?
  externalUrl     String?
  mimeType        String?
  sizeBytes       Int?
  durationSeconds Int?
  language        String?
  tags            String[]
  isFeatured      Boolean              @default(false)
  isPublished     Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        TrainingCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites       TrainingFavorite[]

  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
  @@index([tenantId, isFeatured])
  @@index([categoryId])
}

model TrainingQuiz {
  id                  String                   @id @default(uuid())
  courseId            String
  title               String
  description         String?
  passingScore        Int
  maxAttempts         Int?
  timeLimitMinutes    Int?
  shuffleQuestions    Boolean                  @default(false)
  shuffleOptions      Boolean                  @default(false)
  randomQuestionCount Int?
  cooldownMinutes     Int?
  availableFrom       DateTime?
  availableUntil      DateTime?
  requireAllQuestions Boolean                  @default(true)
  feedbackMode        TrainingQuizFeedbackMode @default(AFTER_SUBMISSION)
  rubric              Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  course              TrainingCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions           TrainingQuizQuestion[]
  attempts            TrainingQuizAttempt[]

  @@index([courseId])
}

model TrainingQuizQuestion {
  id                    String                     @id @default(uuid())
  quizId                String
  prompt                String
  questionType          TrainingQuizQuestionType
  sortOrder             Int                        @default(0)
  explanation           String?
  points                Int                        @default(1)
  requiresManualGrading Boolean                    @default(false)
  bankItemId            String?
  category              String?
  difficulty            TrainingQuestionDifficulty @default(MEDIUM)
  tags                  String[]
  rubric                Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  quiz                  TrainingQuiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options               TrainingQuizOption[]
  answers               TrainingQuizAnswer[]
  bankItem              TrainingQuestionBankItem?  @relation(fields: [bankItemId], references: [id], onDelete: SetNull)

  @@index([quizId, sortOrder])
  @@index([bankItemId])
}

model TrainingQuestionBankItem {
  id                    String                     @id @default(uuid())
  tenantId              String
  prompt                String
  questionType          TrainingQuizQuestionType
  explanation           String?
  points                Int                        @default(1)
  requiresManualGrading Boolean                    @default(false)
  category              String?
  difficulty            TrainingQuestionDifficulty @default(MEDIUM)
  tags                  String[]
  rubric                Json?
  options               Json
  isActive              Boolean                    @default(true)
  createdById           String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quizQuestions         TrainingQuizQuestion[]

  @@index([tenantId, isActive])
  @@index([tenantId, category, difficulty])
}

model TrainingQuizOption {
  id         String               @id @default(uuid())
  questionId String
  label      String
  isCorrect  Boolean              @default(false)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  question   TrainingQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    TrainingQuizAnswer[]

  @@index([questionId, sortOrder])
}

model TrainingQuizAttempt {
  id          String                    @id @default(uuid())
  tenantId    String
  userId      String
  quizId      String
  startedAt   DateTime
  submittedAt DateTime?
  expiresAt   DateTime?
  score       Int?
  passed      Boolean?
  gradedAt    DateTime?
  gradedById  String?
  feedback    String?
  questionIds String[]
  status      TrainingQuizAttemptStatus @default(IN_PROGRESS)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        TrainingQuiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     TrainingQuizAnswer[]

  @@index([tenantId, userId, status])
  @@index([quizId])
}

model TrainingQuizAnswer {
  id                String               @id @default(uuid())
  attemptId         String
  questionId        String
  optionId          String?
  selectedOptionIds String[]
  textAnswer        String?
  isCorrect         Boolean?
  awardedPoints     Int?
  graderFeedback    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attempt           TrainingQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          TrainingQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option            TrainingQuizOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model TrainingCertificate {
  id                String                       @id @default(uuid())
  tenantId          String
  userId            String
  curriculumId      String?
  courseId          String?
  certificateUrl    String
  verificationCode  String                       @unique
  certificateNumber String                       @unique
  policyId          String?
  policyVersion     Int?
  evidenceSnapshot  Json?
  issuedById        String?
  issuedReason      String                       @default("COMPLETION")
  renewedFromId     String?
  supersededAt      DateTime?
  issuedAt          DateTime
  expiresAt         DateTime?
  revokedAt         DateTime?
  revokedById       String?
  revocationReason  String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculum        TrainingCurriculum?          @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  course            TrainingCourse?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  policy            TrainingCertificationPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  renewedFrom       TrainingCertificate?         @relation("TrainingCertificateRenewals", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals          TrainingCertificate[]        @relation("TrainingCertificateRenewals")

  @@index([tenantId, userId, issuedAt])
  @@index([tenantId, courseId, userId, supersededAt])
  @@index([expiresAt, supersededAt, revokedAt])
  @@index([renewedFromId])
}

model TrainingFavorite {
  id                String                     @id @default(uuid())
  tenantId          String
  userId            String
  entityType        TrainingFavoriteEntityType
  courseId          String?
  curriculumId      String?
  libraryResourceId String?
  createdAt         DateTime                   @default(now())
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            TrainingCourse?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  curriculum        TrainingCurriculum?        @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  libraryResource   TrainingLibraryResource?   @relation(fields: [libraryResourceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, courseId])
  @@unique([tenantId, userId, curriculumId])
  @@unique([tenantId, userId, libraryResourceId])
  @@index([tenantId, userId, entityType])
}

model TrainingAnalyticsSnapshot {
  id                 String   @id @default(uuid())
  tenantId           String
  userId             String
  totalMinutes       Int      @default(0)
  totalCourses       Int      @default(0)
  completedCourses   Int      @default(0)
  completionRate     Decimal  @default(0) @db.Decimal(5, 2)
  overdueCourses     Int      @default(0)
  certificatesEarned Int      @default(0)
  generatedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, generatedAt])
}
