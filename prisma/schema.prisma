  @@index([tenantId, courseId])
}

model TrainingScormSession {
  id              String               @id @default(uuid())
  tenantId        String
  packageId       String
  userId          String
  status          String               @default("IN_PROGRESS")
  score           Int?
  progressPercent Int                  @default(0)
  suspendData     Json?
