  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseStep       TrainingCourseStep @relation(fields: [courseStepId], references: [id], onDelete: Cascade)

  @@unique([userId, courseStepId])
  @@index([tenantId, userId])
}

model TrainingEvent {
  id                  String                    @id @default(uuid())
  tenantId            String
  title               String
  description         String?
  startsAt            DateTime
  endsAt              DateTime?
  location            String?
  modality            TrainingEventModality
  relatedCourseId     String?
  relatedCurriculumId String?
  capacity            Int?
  meetingUrl          String?
  timeZone            String                    @default("UTC")
  provider            String?
