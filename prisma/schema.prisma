  owner        User?                       @relation("TrainingImprovementOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?                       @relation("TrainingImprovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, priority])
  @@index([courseId, status])
  @@index([ownerId, status])
}

model TrainingOperationRun {
  id          String                  @id @default(uuid())
  tenantId    String
  actorId     String?
  kind        TrainingOperationKind
  status      TrainingOperationStatus @default(RUNNING)
  result      Json?
  error       String?
