  rubric                Json?
  options               Json
  isActive              Boolean                    @default(true)
  createdById           String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
