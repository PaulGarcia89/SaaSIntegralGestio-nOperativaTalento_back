  deadLetterEvent  DeadLetterEvent?

  @@unique([tenantId, idempotencyKey])
  @@index([status, nextRetryAt, createdAt])
  @@index([tenantId, eventName, eventVersion, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([correlationId, createdAt])
  @@index([causationId, createdAt])
