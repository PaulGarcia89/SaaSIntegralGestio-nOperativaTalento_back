  occurredAt   DateTime                 @default(now())
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        InventoryAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromBranch   Branch?                  @relation("InventoryMovementFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch     Branch?                  @relation("InventoryMovementToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)
  employee     Employee?                @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  evidences    InventoryEvidence[]

  @@index([tenantId, assetId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, employeeId, occurredAt])
}

model InventoryEvidence {
  id           String                @id @default(uuid())
