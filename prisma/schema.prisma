  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  question   TrainingQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    TrainingQuizAnswer[]

  @@index([questionId, sortOrder])
}

model TrainingQuizAttempt {
  id          String                    @id @default(uuid())
  tenantId    String
  userId      String
  quizId      String
  startedAt   DateTime
  submittedAt DateTime?
  expiresAt   DateTime?
  score       Int?
  passed      Boolean?
  gradedAt    DateTime?
  gradedById  String?
  feedback    String?
  questionIds String[]
  status      TrainingQuizAttemptStatus @default(IN_PROGRESS)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        TrainingQuiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     TrainingQuizAnswer[]

  @@index([tenantId, userId, status])
  @@index([quizId])
}

model TrainingQuizAnswer {
  id                String               @id @default(uuid())
  attemptId         String
  questionId        String
  optionId          String?
  selectedOptionIds String[]
  textAnswer        String?
  isCorrect         Boolean?
  awardedPoints     Int?
  graderFeedback    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attempt           TrainingQuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          TrainingQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
