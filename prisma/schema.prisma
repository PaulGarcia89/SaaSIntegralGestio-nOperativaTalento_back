  @@index([branchId])
}

model Vacancy {
  id                     String                     @id @default(uuid())
  tenantId               String
  branchId               String
  createdByUserId        String?
  requisitionId          String?
  clonedFromVacancyId    String?
  title                  String
  summary                String?
  description            String?
  requirements           String?
  responsibilities       String?
  benefits               String?
  city                   String?
  country                String?
  department             String?
  seniority              String?
  workMode               VacancyWorkMode            @default(ON_SITE)
  employmentType         VacancyEmploymentType      @default(FULL_TIME)
  openings               Int                        @default(1)
  salaryMin              Int?
  salaryMax              Int?
  currency               String?                    @default("COP")
  imageUrl               String?
  applicationFormSchema  Json?
  status                 VacancyStatus              @default(OPEN)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByUser          User?                      @relation("VacancyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  requisition            PersonnelRequisition?      @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  clonedFromVacancy      Vacancy?                   @relation("VacancyCloneSource", fields: [clonedFromVacancyId], references: [id], onDelete: SetNull)
  clones                 Vacancy[]                  @relation("VacancyCloneSource")
  locations              VacancyLocation[]
  changeEvents           VacancyChangeEvent[]
  applications           VacancyApplication[]
  stages                 VacancyStage[]
  responsibles           VacancyResponsible[]
  imageFiles             VacancyImageFile[]
