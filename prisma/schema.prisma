  @@index([purchaseOrderId])
}

model InventoryAsset {
  id                   String                       @id @default(uuid())
  tenantId             String
  itemId               String
  branchId             String
  employeeId           String?
  workflowAssignmentId String?                      @unique
  assetTag             String
  serialNumber         String?
  status               InventoryAssetStatus         @default(AVAILABLE)
  condition            InventoryAssetCondition      @default(GOOD)
  notes                String?
  assignedAt           DateTime?
  deliveredAt          DateTime?
  returnRequestedAt    DateTime?
  returnedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item                 InventoryItem                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  branch               Branch                       @relation("InventoryAssetCurrentBranch", fields: [branchId], references: [id], onDelete: Restrict)
  employee             Employee?                    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  workflowAssignment   InventoryAssignment?         @relation(fields: [workflowAssignmentId], references: [id], onDelete: SetNull)
  movements            InventoryMovement[]
  evidences            InventoryEvidence[]
  maintenanceTickets   InventoryMaintenanceTicket[]

  @@unique([tenantId, assetTag])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, branchId, status])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, itemId])
}

model InventoryMaintenanceTicket {
  id           String         @id @default(uuid())
  tenantId     String
  assetId      String
  type         String
  status       String         @default("OPEN")
  title        String
  description  String?
  dueAt        DateTime?
  resolvedAt   DateTime?
  costAmount   Decimal?       @db.Decimal(14, 2)
  currency     String         @default("USD")
  vendor       String?
  createdById  String
  resolvedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  asset        InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assetId])
}

model InventoryMovement {
  id           String                   @id @default(uuid())
  tenantId     String
  assetId      String
  type         InventoryMovementType
  fromBranchId String?
  toBranchId   String?
