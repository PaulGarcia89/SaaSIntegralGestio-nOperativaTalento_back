}

model TrainingCourse {
  id                          String                        @id @default(uuid())
  tenantId                    String?
  curriculumId                String?
  categoryId                  String?
  title                       String
  slug                        String
  summary                     String?
  description                 String?
  coverImageUrl               String?
  type                        TrainingCourseType
  resourceType                TrainingResourceType
  resourceUrl                 String?
  estimatedMinutes            Int                           @default(0)
  difficulty                  TrainingDifficulty            @default(BEGINNER)
  points                      Int?
  isRequired                  Boolean                       @default(false)
  isPublished                 Boolean                       @default(false)
  status                      TrainingCourseStatus          @default(DRAFT)
  language                    String                        @default("es")
  introVideoUrl               String?
  scheduledPublishAt          DateTime?
  scheduledRetireAt           DateTime?
  publishedAt                 DateTime?
  retiredAt                   DateTime?
  version                     Int                           @default(1)
  sourceCourseId              String?
  createdById                 String?
  updatedById                 String?
  tags                        String[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  tenant                      Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculum                  TrainingCurriculum?           @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  category                    TrainingCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  steps                       TrainingCourseStep[]
  modules                     TrainingCourseModule[]
  versions                    TrainingCourseVersion[]
  transitions                 TrainingCourseTransition[]
  assignments                 TrainingAssignment[]
  launches                    TrainingLaunch[]
  improvements                TrainingCourseImprovement[]
  progressRecords             TrainingProgress[]
  events                      TrainingEvent[]
  quizzes                     TrainingQuiz[]
  certificates                TrainingCertificate[]
  compliancePolicies          TrainingCompliancePolicy[]
  scormPackages               TrainingScormPackage[]
  favorites                   TrainingFavorite[]
  workflowTrainingAssignments WorkflowTrainingAssignment[]
  TrainingActivation          TrainingActivation[]
  pathEntries                 TrainingPathCourse[]          @relation("TrainingPathCourse")
  prerequisiteEntries         TrainingPathCourse[]          @relation("TrainingPathPrerequisite")
  onboardingRules             TrainingOnboardingRule[]
  brief                       TrainingCourseBrief?
  courseCompetencies          TrainingCourseCompetency[]
  learningObjectives          TrainingLearningObjective[]
  audienceRules               TrainingAudienceRule[]
  certificationPolicy         TrainingCertificationPolicy?
  qualityReviews              TrainingCourseQualityReview[]
  pilots                      TrainingCoursePilot[]

  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
  @@index([tenantId, status])
  @@index([scheduledPublishAt])
  @@index([scheduledRetireAt])
  @@index([sourceCourseId])
  @@index([curriculumId])
  @@index([categoryId])
  @@index([type])
}

