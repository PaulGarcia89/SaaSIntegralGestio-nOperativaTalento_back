model OutboxEvent {
  id               String                @id @default(uuid())
  tenantId         String
  branchId         String?
  userId           String?
  aggregateType    String
  aggregateId      String?
  eventName        String
  eventVersion     Int                   @default(1)
  payload          Json
  status           OutboxEventStatus     @default(PENDING)
  retryCount       Int                   @default(0)
  maxAttempts      Int                   @default(10)
