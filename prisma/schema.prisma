  tenantId     String
  itemId       String
  branchId     String
  locationId   String?
  type         String
  quantity     Int
  balanceAfter Int
  reason       String?
  actorUserId  String
  occurredAt   DateTime @default(now())

  @@index([tenantId, itemId, occurredAt])
  @@index([tenantId, branchId, occurredAt])
}

model InventoryStockCount {
  id          String   @id @default(uuid())
