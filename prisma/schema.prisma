model Tenant {
  id                            String                        @id @default(uuid())
  name                          String
  slug                          String                        @unique
  status                        TenantStatus                  @default(ACTIVE)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  users                         User[]
  roles                         Role[]
  subscription                  Subscription?
  auditLogs                     AuditLog[]
  candidates                    Candidate[]
  branches                      Branch[]
  employees                     Employee[]
  employeeBranches              EmployeeBranch[]
  vacancies                     Vacancy[]
  vacancyFormTemplates          VacancyFormTemplate[]
  vacancyStages                 VacancyStage[]
  vacancyResponsibles           VacancyResponsible[]
  applications                  VacancyApplication[]
  applicationInterviews         ApplicationInterview[]
  interviewScorecards           InterviewScorecard[]
  inventoryItems                InventoryItem[]
  inventoryStocks               InventoryStock[]
  inventoryAssets               InventoryAsset[]
  inventoryMovements            InventoryMovement[]
  inventoryEvidences            InventoryEvidence[]
  trainingModuleAccesses        TenantTrainingModuleAccess[]
  trainingCategories            TrainingCategory[]
  trainingCurriculums           TrainingCurriculum[]
  trainingPathCourses           TrainingPathCourse[]
  trainingOnboardingRules       TrainingOnboardingRule[]
  trainingCourses               TrainingCourse[]
  trainingAssignments           TrainingAssignment[]
  trainingLaunches              TrainingLaunch[]
  trainingImprovements          TrainingCourseImprovement[]
  trainingOperationRuns         TrainingOperationRun[]
  trainingProgressRecords       TrainingProgress[]
  trainingStepProgressRecords   TrainingStepProgress[]
  trainingLessonProgressRecords TrainingLessonProgress[]
  trainingEvents                TrainingEvent[]
  trainingLibraryResources      TrainingLibraryResource[]
  trainingQuizAttempts          TrainingQuizAttempt[]
  trainingQuestionBankItems     TrainingQuestionBankItem[]
  trainingCertificates          TrainingCertificate[]
  trainingCertificationPolicies TrainingCertificationPolicy[]
  trainingCourseQualityReviews  TrainingCourseQualityReview[]
  trainingCoursePilots          TrainingCoursePilot[]
  trainingCompliancePolicies    TrainingCompliancePolicy[]
  trainingScormPackages         TrainingScormPackage[]
  trainingFavorites             TrainingFavorite[]
  trainingAnalyticsSnapshots    TrainingAnalyticsSnapshot[]
  featureFlags                  TenantFeatureFlag[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  notificationDeliveries        NotificationDelivery[]
  billingCustomer               BillingCustomer?
  billingInvoices               BillingInvoice[]
  userSessions                  UserSession[]
  masterWorkflows               MasterWorkflow[]
  workflowSteps                 WorkflowStep[]
  hiringFlows                   HiringFlow[]
  onboardingFlows               OnboardingFlow[]
  onboardingTasks               OnboardingTask[]
  onboardingTemplates           OnboardingTemplate[]
  onboardingTemplateTasks       OnboardingTemplateTask[]
  employeeDocuments             EmployeeDocument[]
  signaturePackages             SignaturePackage[]
  signatureParticipants         SignatureParticipant[]
  signatureTemplates            SignatureTemplate[]
  signatureAuditEvents          SignatureAuditEvent[]
  inventoryAssignments          InventoryAssignment[]
  inventoryRecoveries           InventoryRecovery[]
  workflowTrainingAssignments   WorkflowTrainingAssignment[]
  accessTasks                   AccessTask[]
  productivityReviews           ProductivityReview[]
  operationalEvents             OperationalEvent[]
  workflowBlockers              WorkflowBlocker[]
  automationRules               AutomationRule[]
  automationExecutions          AutomationExecution[]
  automationExecutionSteps      AutomationExecutionStep[]
  automationAuditLogs           AutomationAuditLog[]
  outboxEvents                  OutboxEvent[]
  outboxEventDispatches         OutboxEventDispatch[]
  integrationEventLogs          IntegrationEventLog[]
  deadLetterEvents              DeadLetterEvent[]
  policyChecks                  PolicyCheck[]
  assetAssignments              AssetAssignment[]
  trainingActivations           TrainingActivation[]
  platformTenantAccesses        PlatformTenantAccess[]
}

model User {
  id                            String                      @id @default(uuid())
  tenantId                      String
  activeBranchId                String?
  email                         String
  passwordHash                  String
  firstName                     String
  lastName                      String
  status                        UserStatus                  @default(ACTIVE)
  isSuperAdmin                  Boolean                     @default(false)
  refreshTokenHash              String?
  lastLoginAt                   DateTime?
  lastSeenAt                    DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  tenant                        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activeBranch                  Branch?                     @relation("UserActiveBranch", fields: [activeBranchId], references: [id], onDelete: SetNull)
  userRoles                     UserRole[]
  userPermissions               UserPermission[]
  auditLogs                     AuditLog[]
  branchAccesses                UserBranchAccess[]
  platformTenantAccesses        PlatformTenantAccess[]
  createdVacancies              Vacancy[]                   @relation("VacancyCreatedBy")
  assignedTrainingAssignments   TrainingAssignment[]        @relation("TrainingAssignmentsUser")
  createdTrainingAssignments    TrainingAssignment[]        @relation("TrainingAssignmentsAssignedBy")
  createdTrainingLaunches       TrainingLaunch[]            @relation("TrainingLaunchCreatedBy")
  ownedTrainingImprovements     TrainingCourseImprovement[] @relation("TrainingImprovementOwner")
  createdTrainingImprovements   TrainingCourseImprovement[] @relation("TrainingImprovementCreatedBy")
  triggeredTrainingOperations   TrainingOperationRun[]      @relation("TrainingOperationActor")
  trainingProgressRecords       TrainingProgress[]
  trainingStepProgressRecords   TrainingStepProgress[]
  trainingLessonProgressRecords TrainingLessonProgress[]
  trainingEventAttendances      TrainingEventAttendance[]
  trainingQuizAttempts          TrainingQuizAttempt[]
  trainingCertificates          TrainingCertificate[]
  trainingFavorites             TrainingFavorite[]
  trainingAnalyticsSnapshots    TrainingAnalyticsSnapshot[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  notificationDeliveries        NotificationDelivery[]
  sessions                      UserSession[]
  outboxEvents                  OutboxEvent[]
  triggeredWorkflows            MasterWorkflow[]            @relation("WorkflowTriggeredBy")
  operationalEvents             OperationalEvent[]          @relation("OperationalEventActor")
  productivityReviews           ProductivityReview[]        @relation("ProductivityReviewActor")
  createdAutomationRules        AutomationRule[]            @relation("AutomationRuleCreatedBy")
  automationExecutions          AutomationExecution[]       @relation("AutomationExecutionActor")
  automationAuditLogs           AutomationAuditLog[]        @relation("AutomationAuditActor")
  policyChecks                  PolicyCheck[]               @relation("PolicyCheckCreatedBy")
  assignedInterviews            VacancyApplication[]        @relation("ApplicationInterviewer")
  supervisedEmployees           Employee[]                  @relation("EmployeeSupervisor")
  vacancyResponsibilities       VacancyResponsible[]
  scheduledInterviews           ApplicationInterview[]      @relation("ScheduledInterviewer")
  createdInterviews             ApplicationInterview[]      @relation("InterviewCreatedBy")
  interviewScorecards           InterviewScorecard[]

  @@unique([tenantId, email])
  @@index([activeBranchId])
  @@index([tenantId])
}

model Role {
  id              String           @id @default(uuid())
  tenantId        String
  code            String
  name            String
  description     String?
  scope           AccessScope      @default(TENANT)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Plan {
  id                           String                       @id @default(uuid())
  code                         PlanCode                     @unique
  name                         String
  description                  String?
  priceMonthly                 Decimal?                     @db.Decimal(10, 2)
  priceYearly                  Decimal?                     @db.Decimal(10, 2)
  limits                       Json?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  subscriptions                Subscription[]
  planModules                  PlanModule[]
  tenantTrainingModuleAccesses TenantTrainingModuleAccess[]
}

model FeatureModule {
  id          String       @id @default(uuid())
  code        ModuleCode   @unique
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  planModules PlanModule[]
}

model PlanModule {
  planId    String
  moduleId  String
  enabledAt DateTime      @default(now())
  plan      Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  module    FeatureModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
}

model Subscription {
  id                     String                       @id @default(uuid())
  tenantId               String                       @unique
  planId                 String
  status                 SubscriptionStatus           @default(ACTIVE)
  startsAt               DateTime
  endsAt                 DateTime?
  trialEndsAt            DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  billingProvider        BillingProvider?
  billingExternalId      String?
  billingCustomerId      String?
  currency               String?                      @default("USD")
  tenant                 Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   Plan                         @relation(fields: [planId], references: [id])
  trainingModuleAccesses TenantTrainingModuleAccess[]
  billingInvoices        BillingInvoice[]

  @@index([planId])
}

model TenantFeatureFlag {
  id         String     @id @default(uuid())
  tenantId   String
  moduleCode ModuleCode
  enabled    Boolean    @default(true)
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleCode])
  @@index([tenantId, enabled])
}

model Notification {
  id               String                 @id @default(uuid())
  tenantId         String
  userId           String?
  type             NotificationType       @default(INFO)
  category         NotificationCategory   @default(GENERAL)
  title            String
  message          String
  sourceModule     String?
  actionUrl        String?
  correlationId    String?
  deduplicationKey String?
  payload          Json?
  readAt           DateTime?
  archivedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries       NotificationDelivery[]

  @@unique([tenantId, userId, deduplicationKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, readAt, createdAt])
  @@index([tenantId, userId, category, createdAt])
  @@index([correlationId])
}

model NotificationPreference {
  id              String                      @id @default(uuid())
  tenantId        String
  userId          String
  category        NotificationCategory
  internalEnabled Boolean                     @default(true)
  emailEnabled    Boolean                     @default(true)
  frequency       NotificationDigestFrequency @default(IMMEDIATE)
  quietHoursStart String?
  quietHoursEnd   String?
  timeZone        String                      @default("UTC")
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category])
  @@index([tenantId, userId])
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  tenantId          String
  userId            String?
  notificationId    String
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  maxAttempts       Int                        @default(5)
  nextAttemptAt     DateTime                   @default(now())
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  providerMessageId String?
  lastError         String?
  correlationId     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, userId, createdAt])
  @@index([correlationId])
}

model BillingCustomer {
  id                 String          @id @default(uuid())
  tenantId           String          @unique
  provider           BillingProvider @default(STRIPE)
  externalCustomerId String
  email              String?
  name               String?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([provider, externalCustomerId])
