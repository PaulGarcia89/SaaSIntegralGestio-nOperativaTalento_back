}

model TrainingWebhook {
  id              String                    @id @default(uuid())
  tenantId        String
  name            String
  endpointUrl     String
  eventTypes      String[]
  secretHash      String
  secretEncrypted String?
  isActive        Boolean                   @default(true)
  lastStatus      String?
  lastError       String?
  lastDeliveryAt  DateTime?
  createdById     String?
