# Copy to .env.self-hosted and replace every CHANGE_ME value.
POSTGRES_DB=saas_integral_gestion_operativa
POSTGRES_USER=saas_app
POSTGRES_PASSWORD=replace-with-postgres-password
REDIS_PASSWORD=replace-with-redis-password
FRONTEND_CONTEXT=../frontend-app
HTTP_PORT=80

JWT_ACCESS_SECRET=replace-with-access-secret-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-refresh-secret-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=true

# Public browser origin. Multiple origins may be comma-separated.
CORS_ALLOWED_ORIGINS=https://app.example.com
PUBLIC_FRONTEND_URL=https://app.example.com

MESSAGE_BUS_DRIVER=bullmq
MESSAGING_ENABLED=true

# S3-compatible storage. Prefer separate buckets for each data class.
ATS_FILE_STORAGE_DRIVER=s3
ATS_FILE_S3_BUCKET=talento-ats
ATS_FILE_S3_REGION=us-east-1
ATS_FILE_S3_ENDPOINT=https://s3.lessacorp.com
ATS_FILE_S3_FORCE_PATH_STYLE=false
ATS_FILE_S3_ACCESS_KEY_ID=CHANGE_ME
ATS_FILE_S3_SECRET_ACCESS_KEY=CHANGE_ME
ATS_FILE_S3_SSE=true

DOCUMENT_STORAGE_DRIVER=s3
DOCUMENT_S3_BUCKET=talento-documents
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ENDPOINT=https://s3.lessacorp.com
DOCUMENT_S3_FORCE_PATH_STYLE=false
DOCUMENT_S3_ACCESS_KEY_ID=CHANGE_ME
DOCUMENT_S3_SECRET_ACCESS_KEY=CHANGE_ME
DOCUMENT_S3_SSE=true

SCORM_STORAGE_DRIVER=s3
SCORM_S3_BUCKET=talento-scorm
SCORM_S3_REGION=us-east-1
SCORM_S3_ENDPOINT=https://s3.lessacorp.com
SCORM_S3_FORCE_PATH_STYLE=false
SCORM_S3_ACCESS_KEY_ID=CHANGE_ME
SCORM_S3_SECRET_ACCESS_KEY=CHANGE_ME
SCORM_S3_SSE=true

DOCUSEAL_BASE_URL=https://docuseal.lessacorp.com
DOCUSEAL_API_KEY=CHANGE_ME
DOCUSEAL_WEBHOOK_SECRET=CHANGE_ME
DOCUSEAL_TEMPLATE_EMPLOYMENT_AGREEMENT_ID=CHANGE_ME
DOCUSEAL_TEMPLATE_NDA_ID=CHANGE_ME

SCORM_ANTIVIRUS_MODE=clamav
ANTIVIRUS_ALLOW_UNSCANNED_UPLOADS=false
SCORM_MAX_UPLOAD_BYTES=104857600
SCORM_TENANT_QUOTA_BYTES=2147483648
SCORM_TENANT_PACKAGE_LIMIT=250
