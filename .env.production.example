NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0

# Generate independent values with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SCORM_SIGNING_KEY=
WEBHOOK_ENCRYPTION_KEY=
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_OAUTH_STATE_SECRET=
AUTH_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://saa-s-integral-gestio-n-operativa-t.vercel.app

MESSAGE_BUS_DRIVER=bullmq
MESSAGING_ENABLED=true
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_POLL_MS=30000
# HTTPS endpoint for the selected email provider adapter.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=

# OAuth applications must allow the exact frontend callback URL:
# https://YOUR_FRONTEND/ats/interviews?calendarProvider=PROVIDER
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT_ID=common
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

SCORM_STORAGE_DRIVER=s3
SCORM_S3_REGION=us-east-1
SCORM_S3_BUCKET=
SCORM_S3_ENDPOINT=
SCORM_S3_FORCE_PATH_STYLE=false
SCORM_S3_ACCESS_KEY_ID=
SCORM_S3_SECRET_ACCESS_KEY=
SCORM_ANTIVIRUS_MODE=clamav
SCORM_CLAMAV_HOST=clamav
SCORM_CLAMAV_PORT=3310
SCORM_ALLOW_UNSCANNED_UPLOADS=false
SCORM_MAX_UPLOAD_BYTES=104857600
SCORM_TENANT_QUOTA_BYTES=2147483648
SCORM_TENANT_PACKAGE_LIMIT=250

BACKUP_ROOT=/var/backups/saas-integral
