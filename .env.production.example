NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0

# Generate independent values with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SCORM_SIGNING_KEY=
WEBHOOK_ENCRYPTION_KEY=
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_OAUTH_STATE_SECRET=
AUTH_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://saa-s-integral-gestio-n-operativa-t.vercel.app

MESSAGE_BUS_DRIVER=bullmq
MESSAGING_ENABLED=true
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_POLL_MS=30000
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOTIFICATION_FROM_EMAIL="Talentos <notificaciones@your-domain.example>"
CANDIDATE_PORTAL_URL=https://your-frontend.example.com
DOCUSEAL_BASE_URL=https://api.docuseal.com
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_TEMPLATE_EMPLOYMENT_AGREEMENT_ID=
DOCUSEAL_TEMPLATE_EMPLOYMENT_AGREEMENT_URL=
DOCUSEAL_TEMPLATE_NDA_ID=
DOCUSEAL_TEMPLATE_NDA_URL=
CANDIDATE_JWT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=

# OAuth applications must allow the exact frontend callback URL:
# https://YOUR_FRONTEND/ats/interviews?calendarProvider=PROVIDER
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT_ID=common
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

SCORM_STORAGE_DRIVER=s3
SCORM_S3_REGION=us-east-1
SCORM_S3_BUCKET=
SCORM_S3_ENDPOINT=
SCORM_S3_FORCE_PATH_STYLE=false
SCORM_S3_ACCESS_KEY_ID=
SCORM_S3_SECRET_ACCESS_KEY=
SCORM_ANTIVIRUS_MODE=clamav
SCORM_CLAMAV_HOST=clamav
SCORM_CLAMAV_PORT=3310
SCORM_ALLOW_UNSCANNED_UPLOADS=false
SCORM_MAX_UPLOAD_BYTES=104857600
SCORM_TENANT_QUOTA_BYTES=2147483648
SCORM_TENANT_PACKAGE_LIMIT=250
TRAINING_VIDEO_MAX_UPLOAD_BYTES=524288000
# Comma-separated HTTPS hosts allowed for externally hosted training videos.
TRAINING_VIDEO_ALLOWED_HOSTS=

BACKUP_ROOT=/var/backups/saas-integral
ATS_SLA_WORKER_ENABLED=true
ATS_SLA_POLL_MS=300000

# Cloudflare R2 gratuito para archivos privados de ATS. Cree un token de API
# "Object Read & Write" limitado exclusivamente al bucket indicado.
ATS_FILE_STORAGE_DRIVER=s3
ATS_FILE_STORAGE_PROVIDER=r2
ATS_FILE_S3_REGION=auto
ATS_FILE_S3_BUCKET=talentos-ats-private
ATS_FILE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
ATS_FILE_S3_FORCE_PATH_STYLE=false
ATS_FILE_S3_ACCESS_KEY_ID=
ATS_FILE_S3_SECRET_ACCESS_KEY=
# R2 cifra automáticamente objetos y metadatos con AES-256.
ATS_FILE_S3_SSE=false
ATS_FILE_SIGNING_SECRET=
ATS_FILE_DIRECT_URL_TTL_SECONDS=60
ATS_RESUME_RETENTION_DAYS=730
ATS_VACANCY_IMAGE_RETENTION_DAYS=365
ATS_STORAGE_MAINTENANCE_ENABLED=true
ATS_STORAGE_MAINTENANCE_POLL_MS=21600000
ATS_STORAGE_RETENTION_BATCH_SIZE=100
# Alerta a 8 GiB antes del nivel gratuito configurado de 10 GiB.
ATS_FILE_STORAGE_ALERT_BYTES=8589934592
ATS_FILE_STORAGE_FREE_TIER_BYTES=10737418240
