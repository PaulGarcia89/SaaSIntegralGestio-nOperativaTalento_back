ATS_SLA_POLL_MS=300000
AI_COMPETENCY_SIGNATURE_SECRET="replace-with-independent-signature-secret"

# --- Limitacion de tasa y cabeceras de seguridad ---
# Usa Redis si REDIS_URL / REDIS_HOST estan configurados; si no, contador en memoria.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
# Proxies de confianza delante de la app (1 = nginx). 0 si se expone directamente.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=15552000

# --- Guard global de autenticacion (hallazgo CRITICO-4 de la auditoria) ---
# false/ausente = comportamiento actual (cada controlador declara sus guards).
# true = toda ruta exige token salvo las marcadas con @Public().
# Leer docs/GLOBAL_AUTH_GUARD.md antes de activarlo.
GLOBAL_AUTH_GUARD_ENABLED=false

# --- Alias legacy de permisos de inventario (hallazgo ALTA-8) ---
# Actualmente activos por defecto. Poner a false para exigir permisos granulares.
INVENTORY_LEGACY_PERMISSION_FALLBACK=true

# --- Vigilancia del aislamiento multiempresa (hallazgo CRITICO-3) ---
# off   = sin vigilancia
# warn  = solo observa y registra (por defecto; no altera ninguna consulta)
# block = ademas corta las consultas colectivas y las escrituras sin tenantId
# Leer docs/AISLAMIENTO_MULTIEMPRESA.md antes de pasar a block.
TENANT_SCOPE_ENFORCEMENT=warn
