# Paste these values in Portainer Stack > Environment variables.
# This is a template only. Never commit a real .env file or production secrets.

POSTGRES_DB=saas_integral_gestion_operativa
POSTGRES_USER=saas_app
# Use URL-safe hexadecimal values because Compose interpolates these into URLs.
# Generate each independently with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTERS

# Generate independent secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTERS
CANDIDATE_JWT_SECRET=

# Use the public URL that users will open. Include the scheme and no trailing slash.
PUBLIC_FRONTEND_URL=https://your-frontend-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com
AUTH_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=true

# Email: choose RESEND or SMTP. Do not configure both accidentally.
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
NOTIFICATION_FROM_EMAIL=Talentos <notificaciones@your-verified-domain.example.com>
# For SMTP instead: EMAIL_PROVIDER=SMTP, port 465+TLS or 587+STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_DELIVERY_WORKER_ENABLED=true
NOTIFICATION_DELIVERY_POLL_MS=30000

# GHCR images are pulled by Portainer. Change the tag to pin a tested release.
BACKEND_IMAGE=ghcr.io/paulgarcia89/saas-integral-backend
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE=ghcr.io/paulgarcia89/saas-integral-frontend
FRONTEND_IMAGE_TAG=latest

# Host ports exposed by this Stack.
BACKEND_PORT=3000
FRONTEND_PORT=3001
